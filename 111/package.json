{
  "name": "wordbridge-translation",
  "version": "1.0.0",
  "private": true,
  "description": "Word Bridge Translation (Trans) - Global Translation Platform (dichthuat.wordbridge.io.vn) with Strict Zero User Data Storage",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "build": "node scripts/build.js",
    "audit:privacy": "node scripts/build.js --audit-only",
    "test": "node tests/full-system.test.js",
    "db:migrate:local": "npx wrangler d1 execute word --local --file=./migrations/0001_site_metrics_zero_storage.sql",
    "db:migrate:remote": "npx wrangler d1 execute word --remote --file=./migrations/0001_site_metrics_zero_storage.sql",
    "deploy": "npx wrangler deploy"
  },
  "keywords": [
    "word-bridge",
    "translation",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "zero-data-storage",
    "dichthuat"
  ],
  "author": "Word Bridge Ecosystem (wordbridge.io.vn)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  }
}
