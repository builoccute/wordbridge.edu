{
  "name": "wordbridge",
  "version": "2026.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --check worker.js && for f in src/*.js public/assets/app.js; do node --check \"$f\"; done",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply word --local",
    "db:migrate:remote": "wrangler d1 migrations apply word --remote",
    "deploy": "wrangler deploy",
    "db:info": "wrangler d1 info word"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
