{
  "name": "word-bridge",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "WORD BRIDGE — Nền tảng học tập, tra cứu, luyện tập và đánh giá năng lực ngoại ngữ Trung – Anh – Nga (Multi-page Website trên Cloudflare Workers, D1 và R2).",
  "homepage": "https://www.wordbridge.vn/",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "node scripts/run-local-dev.mjs",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply word --local",
    "db:migrate:remote": "wrangler d1 migrations apply word --remote",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "lint:check": "node --check src/index.js"
  },
  "devDependencies": {
    "wrangler": "^4.16.0"
  }
}
