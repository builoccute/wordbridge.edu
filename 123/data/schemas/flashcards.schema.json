{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordBridgeFlashcardItem",
  "type": "object",
  "required": [
    "id",
    "en",
    "zh",
    "pinyin",
    "ipa",
    "vi",
    "pos",
    "example_en",
    "example_zh",
    "example_pinyin",
    "example_vi",
    "topic",
    "domain",
    "level_en",
    "level_zh",
    "deck_scope",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FC-[0-9]{4}$"
    },
    "en": {
      "type": "string",
      "minLength": 1
    },
    "zh": {
      "type": "string",
      "minLength": 1
    },
    "pinyin": {
      "type": "string",
      "minLength": 1
    },
    "ipa": {
      "type": "string",
      "minLength": 2
    },
    "vi": {
      "type": "string",
      "minLength": 1
    },
    "pos": {
      "type": "string",
      "minLength": 1
    },
    "example_en": {
      "type": "string",
      "minLength": 5
    },
    "example_zh": {
      "type": "string",
      "minLength": 2
    },
    "example_pinyin": {
      "type": "string",
      "minLength": 2
    },
    "example_vi": {
      "type": "string",
      "minLength": 5
    },
    "topic": {
      "type": "string",
      "minLength": 2
    },
    "domain": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "level_en": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "level_zh": {
      "type": "string",
      "enum": [
        "HSK 1",
        "HSK 2",
        "HSK 3",
        "HSK 4",
        "HSK 5"
      ]
    },
    "deck_scope": {
      "type": "string",
      "const": "FLASHCARD_ONLY"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW_REQUIRED",
        "VALIDATED_STRUCTURE",
        "EXPERT_REVIEWED",
        "PUBLISHED"
      ]
    }
  }
}